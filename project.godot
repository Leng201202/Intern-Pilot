; Wuxia Valley - Phase 1 exploration slice
; Engine version is pinned in .godot-version.
config_version=5

[application]

config/name="Wuxia Valley"
config/description="A stylized wuxia traversal adventure for the web."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.025, 0.055, 0.058, 1)

[autoload]

GameState="*res://scripts/autoload/game_state.gd"
AudioDirector="*res://scripts/autoload/audio_director.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[input]

move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87,"unicode":119)]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83,"unicode":115)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65,"unicode":97)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68,"unicode":100)]
}
sprint={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194325)]
}
jump={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32,"unicode":32)]
}
air_dash={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":81,"unicode":113)]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69,"unicode":101)]
}
pause={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194305)]
}
reset_checkpoint={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":82,"unicode":114)]
}

[internationalization]

locale/translations=PackedStringArray("res://translations/game.en.po")

[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_2="Player"
3d_physics/layer_3="Triggers"

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=24.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.42, 0.64, 0.68, 1)

