supabase/.branches/
supabase/.temp/
supabase/functions/.env
supabase/functions/.env.*
!supabase/functions/.env.example
!supabase/functions/.env.*.example

# Logs and local tooling
*.log
npm-debug.log*
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
