# Local Edge Function configuration. Copy to an ignored env file and replace
# placeholders. Never use real Gmail or Gemini data in automated tests.
FRONTEND_URL=http://127.0.0.1:5173
GMAIL_OAUTH_CLIENT_ID=replace-with-google-oauth-client-id
GMAIL_OAUTH_CLIENT_SECRET=replace-with-google-oauth-client-secret
GMAIL_OAUTH_CALLBACK_URL=http://127.0.0.1:54321/functions/v1/gmail-oauth-callback
# Base64 for exactly 32 random bytes. Rotate by reauthorizing Gmail connections.
GMAIL_TOKEN_ENCRYPTION_KEY=replace-with-base64-32-byte-key
GMAIL_TOKEN_KEY_VERSION=1
GMAIL_MAX_MESSAGES_PER_SYNC=50
GMAIL_INITIAL_SYNC_MODE=new_only
SCHEDULER_SECRET=replace-with-random-scheduler-secret

# Fail closed by default. All three AI gates must be satisfied before a call:
# backend enablement, explicit real-email risk acceptance, and UI acknowledgement.
AI_EMAIL_ANALYSIS_ENABLED=false
AI_REAL_EMAIL_RISK_ACCEPTED=false
AI_MAX_REQUESTS_PER_SYNC=20
GEMINI_MODEL=replace-with-reviewed-model-name
GEMINI_API_KEY=replace-with-server-side-api-key
